XY_MARKETPLACE_DATABASE=/var/lib/xy-marketplace/marketplace.sqlite3
XY_MARKETPLACE_LISTEN=127.0.0.1:47831
XY_MARKETPLACE_PUBLIC_ORIGIN=https://market.example.invalid
XY_MARKETPLACE_ALLOWED_ORIGINS='["https://market.example.invalid","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]'
XY_MARKETPLACE_REVIEWERS_FILE=/etc/xy-marketplace/reviewers.json
XY_MARKETPLACE_SIGNING_KEY_ID=publisher.release-2026
XY_MARKETPLACE_SIGNING_KEY_FILE=/etc/xy-marketplace/signing-key.pk8
XY_MARKETPLACE_VERIFICATION_KEYS_FILE=/etc/xy-marketplace/verification-keys.json
XY_MARKETPLACE_SESSION_TTL_SECONDS=86400
XY_MARKETPLACE_ALLOW_DEVELOPMENT_HTTP=false
XY_MARKETPLACE_ALLOW_NON_LOOPBACK=false
