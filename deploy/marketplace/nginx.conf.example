limit_req_zone $binary_remote_addr zone=xy_marketplace_auth:10m rate=5r/m;

upstream xy_marketplace {
    server 127.0.0.1:47831;
    keepalive 16;
}

server {
    listen 80;
    server_name market.example.invalid;
    access_log off;
    error_log /var/log/nginx/xy-marketplace.error.log crit;
    return 308 https://market.example.invalid$request_uri;
}

server {
    listen 443 ssl;
    server_name market.example.invalid;
    ssl_certificate /etc/xy-marketplace/tls/fullchain.pem;
    ssl_certificate_key /etc/xy-marketplace/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/xy-marketplace.error.log crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2064k;
    client_body_timeout 15s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Authorization $http_authorization;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    limit_req_status 429;
    error_page 413 = @marketplace_too_large;
    error_page 429 = @marketplace_rate_limited;
    error_page 502 503 504 = @marketplace_unavailable;

    location ~ ^/v1/auth/(register|login)$ {
        client_max_body_size 16k;
        limit_req zone=xy_marketplace_auth burst=5 nodelay;
        proxy_pass http://xy_marketplace;
    }

    location / {
        proxy_pass http://xy_marketplace;
    }

    location @marketplace_too_large {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 413 '{"error":{"code":"invalid_request","message":"The request body exceeds the marketplace limit."}}';
    }

    location @marketplace_rate_limited {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After 60 always;
        return 429 '{"error":{"code":"rate_limited","message":"Wait before retrying this operation."}}';
    }

    location @marketplace_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":{"code":"service_unavailable","message":"The marketplace cannot safely complete this operation."}}';
    }
}
